@startuml Econ
left to right direction
skinparam shadowing false
skinparam roundCorner 12
title Econ  (Econ.tla) - all checks must hold
header honest broker; the writer may cancel the account meanwhile: refunds are parked, never lost
rectangle "Pay\nwriter -> escrow" as pay #DDEEFF
rectangle "Prove\nverdict pass|fail" as prove #DDEEFF
rectangle "Settle\nfee to broker" as settle #DDEEFF
rectangle "paid: SP gets price-fee" as paid #DDEEFF
rectangle "refunded: writer gets price-fee" as refund #DDEEFF
rectangle "Broker pays SP\ndespite failed proof\n(off)" as collude #F2F2F2;line.dotted;line:grey
rectangle "Cancel account\n(writer withdraws)" as cancel #DDEEFF
rectangle "ParkRefund\nunclaimed -> Claim" as park #BBEEBB
rectangle "Refund lost\n(naive)\n(off)" as burn #F2F2F2;line.dotted;line:grey
pay --> prove
prove --> settle
settle --> paid
settle --> refund
collude ..> settle
cancel --> refund
refund --> park
refund ..> burn
legend bottom
|= kind |= name |= TLC result |
| invariant | TypeOK | <color:green><b>holds</b></color> |
| invariant | NoBurn | <color:green><b>holds</b></color> |
| invariant | Conservation | <color:green><b>holds</b></color> |
| invariant | EscrowExact | <color:green><b>holds</b></color> |
| invariant | BrokerIncome | <color:green><b>holds</b></color> |
| invariant | PaidOnlyWithProof | <color:green><b>holds</b></color> |
| invariant | SpIncome | <color:green><b>holds</b></color> |
| invariant | RefundOnFail | <color:green><b>holds</b></color> |
| property | Settled | <color:green><b>holds</b></color> |
| property | Claimed | <color:green><b>holds</b></color> |
endlegend
@enduml

