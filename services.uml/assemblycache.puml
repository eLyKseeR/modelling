' reflects in Coq: theories/AssemblyCache.v (elykseer-ml v0.10.3)

@startuml assemblycache

!theme sunlust

class assemblycache {
    acenvs: list EnvironmentReadable
    acsize: nat
    acwriteenv: EnvironmentWritable
    acconfig: configuration
    acwriteq: writequeue
    acreadq: readqueue
    acfbstore: FBlockListStore
    ackstore: KeyListStore
    acfistore: FileinformationStore

    prepare_assemblycache(configuration, size)
    enqueue_read_request(readqueueentity) -> bool * assemblycache
    enqueue_write_request(writequeueentity) -> bool * assemblycache
    iterate_read_queue() -> list readqueueresult * assemblycache
    iterate_write_queue() -> assemblycache
    ----
    add_fileinformation()
    add_fileblockinformation()
    ----
    flush()
    close()

}

class readqueueentity {
    rqaid: aid_t
    rqapos: int
    rqrlen: int
    rqfpos: int
    rqchecksum: string
}

class writequeueentity {
    qfhash: string
    qfpos: int
    qbuffer: Buffer
}

class readqueueresult {
    readrequest: readqueueentity
    rresult: Buffer
}

class readqueue {
    rqueue: list readqueueentity
}

class writequeue {
    wqueue: list writequeueentity
}

note bottom of readqueue
    both queues are bounded:
    qsize = 12 entries
end note

assemblycache::acreadq *-- "1" readqueue
assemblycache::acwriteq *-- "1" writequeue
readqueue o-- "0..12" readqueueentity
writequeue o-- "0..12" writequeueentity
readqueueresult o-- readqueueentity

@enduml


@startuml assemblycache modules

!theme sunlust

!include ./assemblycache.puml!0
!include ../services.uml/environment.puml!0

assemblycache::acenvs .left. "many" EnvironmentReadable
assemblycache::acwriteenv .. "1" EnvironmentWritable

assemblycache::acfbstore .right. "1" FBlockListStore
assemblycache::ackstore .. "1" KeyListStore
assemblycache::acfistore .. "1" FileinformationStore

remove ENV 
remove readqueueentity
remove writequeueentity
remove readqueueresult
remove readqueue
remove writequeue
remove assemblyinformation
remove environment 
remove keyinformation
remove blockinformation

@enduml

@startuml assemblycache write usage

!theme sunlust

Client -> AssemblyCache : prepare_assemblycache()
AssemblyCache -> EnvironmentWritable : initial_environment()
group repeat
    Client -> AssemblyCache : enqueue_write_request()
    alt queue has room (qsize = 12)
        AssemblyCache --> Client : true
    else queue full
        AssemblyCache --> Client : false
        Client -> AssemblyCache : iterate_write_queue()
        group repeat for each queued block
            AssemblyCache -> EnvironmentWritable : backup()
            group when assembly full
                EnvironmentWritable -> EnvironmentWritable : finalise_and_recreate_assembly()
                AssemblyCache -> KeyListStore : add()
            end
            AssemblyCache -> FBlockListStore : add()
        end
        Client -> AssemblyCache : enqueue_write_request()
    end
end
Client -> AssemblyCache : iterate_write_queue()
Client -> AssemblyCache : close()
AssemblyCache -> EnvironmentWritable : finalise_assembly()
AssemblyCache -> KeyListStore : add()

@enduml

@startuml assemblycache read usage

!theme sunlust

Client -> AssemblyCache : prepare_assemblycache()
group repeat
    Client -> AssemblyCache : enqueue_read_request()
    alt queue has room (qsize = 12)
        AssemblyCache --> Client : true
    else queue full
        AssemblyCache --> Client : false
        Client -> AssemblyCache : iterate_read_queue()
        group repeat for each request
            AssemblyCache -> AssemblyCache : ensure_assembly()
            alt assembly in cache
                AssemblyCache -> AssemblyCache : move to head of acenvs
            else assembly recalled (oldest dropped when acsize reached)
                AssemblyCache -> KeyListStore : find()
                AssemblyCache -> EnvironmentReadable : restore_assembly()
            end
            AssemblyCache -> AssemblyCache : get content at rqapos, length rqrlen
            AssemblyCache -> AssemblyCache : verify checksum (if rqchecksum known)
        end
        AssemblyCache --> Client : list readqueueresult
        Client -> AssemblyCache : enqueue_read_request()
    end
end
Client -> AssemblyCache : iterate_read_queue()

@enduml

@startuml assemblycache components
!theme sunlust

package "AssemblyCache" {
    [EnvironmentReadable] -left- Read
    Write -left- [EnvironmentWritable]
}
package "KeyListStore" {
    AddKey -left- [KeyDb]
    [KeyDb] -left- GetKey
}
package "FBlockListStore" {
    AddBlock -left- [BlockDb]
    [BlockDb] -left- GetBlock
}
package "FileinformationStore" {
    AddFI - [FileinfoDb]
    [FileinfoDb] - GetFI
}
[BackupFile] -down- Write
[RestoreFile] -up- Read

[EnvironmentWritable] -up- AddKey
[EnvironmentWritable] -down- AddBlock
[EnvironmentWritable] -down- AddFI

[EnvironmentReadable] -up- GetKey
[EnvironmentReadable] -down- GetBlock

@enduml
